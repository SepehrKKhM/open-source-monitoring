# Email is the recommended default notification channel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional Telegram notifications. Choose one delivery mode:
#   bot_api: send directly to Telegram with your bot token and destination chat ID.
#   webhook: POST to a workflow endpoint (n8n is one possible workflow platform).
TELEGRAM_MODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TIMEOUT=10

# Optional display name; defaults to the VM hostname.
MONITOR_SERVER_NAME=
